{
  "mcpServers": {
    "gmc": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/AI-Shopping-Feeds/google-merchant-centre-mcp.git",
        "gmc-mcp",
        "run"
      ],
      "env": {
        "GMC_ACCOUNT_ID": "1234567890",
        "GMC_SERVICE_ACCOUNT_KEY": "/abs/path/to/service-account.json",
        "GMC_DRY_RUN": "false",
        "GMC_LOG_LEVEL": "INFO"
      }
    }
  }
}
